load mire::vec
load mire::map
load kioto::strings
load kioto::time
load kioto::fs
load kioto::env
load kioto::proc
load kioto::async
load kioto::mem
load kioto::cpu
load kioto::math
load kioto::net
load kioto::log
load kioto::cli
load kioto::crypto
load! semver
load! util
load! /code/crypto
load! trust
load! registry
load! build
load! check
load! info
load! ui
load! deps
load! args
load! lockfile
load! dload
load! install
load! export
load! gc
load! profile
load! upgrade

pub fn main: () {
    set args = env_args()
    set n = vec::len(args)
    if n < 2 {
        use! ui::help()
        return
    }
    set cmd = args at 1
    if cmd == "build" {
        use! build::build(args)
    } else { if cmd == "run" {
        use! build::run(args)
    } else { if cmd == "test" {
        use! check::test(args)
    } else { if cmd == "check" {
        use! check::check(args)
    } else { if cmd == "info" {
        use! info::info(args)
    } else { if cmd == "checkup" {
        use! check::checkup(args)
    } else { if cmd == "profile" {
        use! profile::profile(args)
    } else { if cmd == "new" {
        use! deps::new(args)
    } else { if cmd == "clean" {
        use! deps::clean(args)
    } else { if cmd == "load" {
        use! deps::load(args)
    } else { if cmd == "install" {
        use! install::run(args)
    } else { if cmd == "export" {
        use! export::run(args)
    } else { if cmd == "reg" {
        use! registry::run(args)
    } else { if cmd == "deps" {
        use! deps::deps(args)
    } else { if cmd == "gc" {
        use! gc::run(args)
    } else { if cmd == "upgrade" {
        use! upgrade::run(args)
    } else { if cmd == "help" || cmd == "-h" || cmd == "--help" {
        use! ui::help()
    } else { if cmd == "version" || cmd == "-V" || cmd == "--version" {
        use! ui::banner()
    } else {
        use! ui::help()
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    }
}
