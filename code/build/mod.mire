module build

load! /code/util
load! /code/lockfile
load! /code/deps
load! /code/install
load! /code/args
load! /code/lockfile

extern fn exit: (code :i64) lib "c"

pub fn ensure_project_dependencies: () :bool {
    set ok = true :bool mut
    if !use! lockfile::exists() {
        /! Fresh project: auto-generate V3 lockfile with owl.toml manifest hash
         and no locked dependencies yet.
         !/
        set manifest_hash = use! util::sha256sum_hex("owl.toml")
        set content = "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + manifest_hash + "\"\n\n# no dependencies\n"
        use fs::write("owl.lock" content)
        use dasu("  [OK]   lockfile auto-generated for fresh project (V3)")
    } else {
        /! Existing lockfile: validate checksum and apply update policy.
         !/
        set lock_content = fs::read("owl.lock")
        if lock_content != "" {
            set expected_manifest = use! util::toml_get_from_string(lock_content "lock" "manifest-sha256")
            set current_manifest = use! util::sha256sum_hex("owl.toml")
            if expected_manifest != current_manifest {
                /! owl.toml has changed: apply update@lock policy.
                 !/
                set cfg_lock = use! util::toml_get("owl.toml" "cfg" "lock") :str mut
                if cfg_lock == "" || cfg_lock == "1" {
                    /! Default: active verification with interactive prompt.
                     !/
                    use dasu("  [WARN] owl.toml has changed since last lockfile generation")
                    use dasu("  [WARN] Update lockfile now? (y/N): ")
                    set answer = use! util::read_line() :str mut
                    if answer == "y" || answer == "Y" {
                        use dasu("  [INFO] regenerating lockfile...")
                        use! lockfile::generate()
                        use dasu("  [OK]   lockfile updated")
                    } else {
                        use dasu("  [INFO] keeping existing lockfile (may be out of date)")
                        /! Skip revalidation to avoid false failures.
                         !/
                        set ok = true
                        return ok
                    }
                } else {
                    /! lock = 0: verification disabled, generate without strict checks.
                     !/
                    use dasu("  [OK]   lockfile: verification disabled (cfg lock = 0)")
                }
            } else {
                /! Checksum matches: lockfile is in sync, skip full validation.
                 !/
                use dasu("  [OK]   lockfile in sync (checksum matches)")
                set ok = true
                return ok
            }
        }
    }
    /! If we reach here, full validation should run (lockfile was updated or needs it).
     !/
    return ok
}

/! Generate the explicit compiler configuration used by `owl test`. Tests
   must receive the same dependency roots and runtime policy as builds; relying
   on Avenys to rediscover owl.toml would quietly reintroduce the old project
   manager boundary. !/
pub fn test_config: (args :&vec[str]) :str {
    if !use! ensure_project_dependencies() {
        use! util::error_line("OWL0003" "dependencies are unresolved")
        exit(1)
    }

    set profile = use! util::config_required("build" "profile") :str mut
    set opt = use! util::config_required("build" "opt-level") :str mut
    if use! args::flag::has(args "--release") || use! args::flag::has(args "-r") {
        set profile = "release"
        set opt = "3"
    }
    if use! args::flag::has(args "--debug") || use! args::flag::has(args "-d") {
        set profile = "debug"
        set opt = "0"
    }
    set requested_opt = use! util::arg_value(args "--opt-level")
    if requested_opt != "" { set opt = requested_opt }

    set entry = use! util::config_required("project" "entry")
    set artifact = use! util::arg_value(args "--artifact") :str mut
    if artifact == "" { 
        set artifact = use! util::config_default("build" "artifact" "bin") 
    }
    use dasu("[DEBUG] build: artifact resolved to [" + artifact + "]")
    // ----- Use project's owl.toml directly instead of creating cached test config !/
    set runtime = use! util::arg_value(args "--runtime") :str mut
    if runtime == "" {
        set runtime = use! util::config_default("build" "runtime" "minimal")
    }
    set target = use! util::arg_value(args "--target") :str mut
    if target == "" { set target = "x86_64-unknown-linux-gnu" }
    set output = use! util::config_required("paths" "output")
    set cache = use! util::config_required("paths" "cache")
    /! Use project's owl.toml directly instead of creating cached test config !/
    set config = "owl.toml"
    /! Ensure dependencies are resolved so compiler can find libs !/
    if !use! ensure_project_dependencies() {
        use! util::error_line("OWL0003" "dependencies are unresolved")
        exit(1)
    }
    return config
}

pub fn compile: (args :&vec[str] is_run :bool) {
    use! fs::write("/tmp/build_debug.txt" "COMPILE FUNCTION CALLED")
    use dasu("[DEBUG] compile called, is_run=" + (if is_run { "true" } else { "false" }))
    set is_proj = use! util::has_project()

    set n = rt_vec_len(args)
    set file_idx = 1 :i64 mut
    set fi = 1 :i64 mut
    while fi < n {
        set fa = rt_vec_get_str(args fi)
        if !use! util::startswith(fa "-") {
            set file_idx = fi
            set fi = n
        }
        set fi += 1
    }

    set i = 1 :i64 mut
    set cli_file = "" :str mut
    set cli_profile = "" :str mut
    set cli_opt = "" :str mut
    set extra_flags = "" :str mut
    set run_args = [] :vec[str] mut
    set seen_ddash = false :bool mut
    while i < n {
        set a = rt_vec_get_str(args i)
        if a == "--" {
            set seen_ddash = true
        } else {
            if !use! util::startswith(a "-") {
                if seen_ddash {
                    set run_args = vec::push::str(run_args strings::copy(a))
                } else {
                    if cli_file == "" { set cli_file = a }
                }
            } else {
                if a == "--debug" || a == "-d" {
                    set cli_profile = "debug"
                    set cli_opt = "0"
                } else {
                    if a == "--release" || a == "-r" {
                        set cli_profile = "release"
                        set cli_opt = "3"
                    } else {
                        if a == "-O" || a == "--opt-level" {
                            set i += 1
                            if i < n { set cli_opt = rt_vec_get_str(args i) }
                        } else {
                            if a == "-O" || a == "--opt-level" {
                                set extra_flags = extra_flags + " " + a
                            } else {
                                if !use! util::startswith(a "-") && cli_file == "" {
                                    set cli_file = a
                                } else {
                                    if use! util::startswith(a "-") {
                                        set extra_flags = extra_flags + " " + a
                                    }
                                }
                            }
                        }
                    }
                }
                set i += 1
            }
        }

    if !is_proj {
        if cli_file == "" {
            if file_idx > 0 && file_idx < n { set cli_file = rt_vec_get_str(args file_idx) }
        }
        if cli_file == "" {
            use! util::error_line("OWL0002" "no file specified and no owl.toml found")
            exit(1)
        } else {
            set argv = [] :vec[str] mut
            if is_run { set argv = vec::push::str(argv "run") } else { set argv = vec::push::str(argv "build") }
            set argv = vec::push::str(argv cli_file)
            if cli_profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
            if cli_opt != "" {
                set argv = vec::push::str(argv "-O")
                set argv = vec::push::str(argv cli_opt)
            }
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            if extra_flags != "" {
                set toks = strings::split(extra_flags " ")
                set ti = 0 :i64 mut
                while ti < len(toks) {
                    set tk = use! util::list_get(toks ti)
                    if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                    set ti += 1
                }
            }
            set out = use! util::run_compiler(argv)
            use dasu(out)
        }
} else {
        if !use! ensure_project_dependencies() {
            use! util::error_line("OWL0003" "dependencies are unresolved")
            exit(1)
        } else {
            set entry = use! util::config_required("project" "entry")
            set file = entry :str mut
            if cli_file != "" && fs::exists(cli_file) { set file = cli_file }
            
            set profile = use! util::config_required("build" "profile") :str mut
            set opt = use! util::config_required("build" "opt-level") :str mut
            if cli_profile != "" { set profile = cli_profile }
            if cli_opt != "" { set opt = cli_opt }
            
            set out_dir = use! util::config_required("paths" "output") :str mut
            set cache_dir = use! util::config_required("paths" "cache") :str mut
            
            /! Use project's owl.toml directly instead of creating cached mire-config.toml !/
            set mire_config = "owl.toml"
            
            set argv = [] :vec[str] mut
            set argv = vec::push::str(argv "build")
            set argv = vec::push::str(argv strings::copy(file))
            set argv = vec::push::str(argv "--config")
            set argv = vec::push::str(argv "owl.toml")
            if profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
            set argv = vec::push::str(argv "-O")
            set argv = vec::push::str(argv strings::copy(opt))
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            if extra_flags != "" {
                set toks = strings::split(extra_flags " ")
                set ti = 0 :i64 mut
                while ti < len(toks) {
                    set tk = use! util::list_get(toks ti)
                    if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                    set ti += 1
                }
            }
            use dasu("  [" + profile + " -O" + opt + "]")
            
            if is_run {
                set build_out = use! util::run_compiler(argv)
                use dasu(build_out)
                if use proc::run_last_exit() == 0 { 
                    use! util::record_build() 
                    set name = entry :str mut
                    if cli_file != "" && (fs::exists(cli_file) || use! util::endswith(cli_file ".mire")) { set name = cli_file }
                    if use! util::endswith(name ".mire") {
                        set name = use! util::replace(name ".mire" "")
                    }
                    set parts = use! util::split(name "/")
                    set name = use! util::list_get(parts len(parts) - 1)
                    set bin = "./" + out_dir2 + "/" + profile + "/" + name :str mut
                    use dasu("")
                    use dasu("  running " + bin + " ...")
                    use proc::run_spawn(bin run_args)
                }
            } else {
                set out = use! util::run_compiler(argv)
                use dasu(out)
                if use proc::run_last_exit() == 0 { use! util::record_build() }
            }
        }
    }
}

pub fn debug: (args :&vec[str]) {
    set is_proj = use! util::has_project()
    set n = rt_vec_len(args)

    set file_idx = 1 :i64 mut
    set fi = 1 :i64 mut
    while fi < n {
        set fa = rt_vec_get_str(args fi)
        if !use! util::startswith(fa "-") {
            set file_idx = fi
            set fi = n
        }
        set fi += 1
    }

    set extra_flags = "" :str mut
    set i = 1 :i64 mut
    while i < n {
        set a = rt_vec_get_str(args i)
        if a == "--tokens" || a == "-t" {
            set argv = [] :vec[str] mut
            set argv = vec::push::str(argv "debug")
            set argv = vec::push::str(argv "--tokens")
            set argv = vec::push::str(argv "-O0")
            set argv = vec::push::str(argv "--no-optimize")
            set argv = vec::push::str(argv "--config")
            set argv = vec::push::str(argv "bin/debug/mire-config.toml")
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            use! util::run_compiler(argv)
            return
        } else {
            if a == "--ast" || a == "-p" {
                set argv = [] :vec[str] mut
                set argv = vec::push::str(argv "debug")
                set argv = vec::push::str(argv "--ast")
                set argv = vec::push::str(argv "-O0")
                set argv = vec::push::str(argv "--no-optimize")
                set argv = vec::push::str(argv "--config")
                set argv = vec::push::str(argv "bin/debug/mire-config.toml")
                set argv = vec::push::str(argv "--lib-dir")
                set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
                use! util::run_compiler(argv)
                return
            }
            if a == "--ir" {
                set argv = [] :vec[str] mut
                set argv = vec::push::str(argv "debug")
                set argv = vec::push::str(argv "--ir")
                set argv = vec::push::str(argv "-O0")
                set argv = vec::push::str(argv "--no-optimize")
                set argv = vec::push::str(argv "--config")
                set argv = vec::push::str(argv "bin/debug/mire-config.toml")
                set argv = vec::push::str(argv "--lib-dir")
                set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
                use! util::run_compiler(argv)
                return
            }
            if a == "--run" || a == "-r" {
                set argv = [] :vec[str] mut
                set argv = vec::push::str(argv "run")
                set argv = vec::push::str(argv "-O0")
                set argv = vec::push::str(argv "--no-optimize")
                set argv = vec::push::str(argv "--config")
                set argv = vec::push::str(argv "bin/debug/mire-config.toml")
                set argv = vec::push::str(argv "--lib-dir")
                set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
                use! util::run_compiler(argv)
                return
            }
            if !use! util::startswith(a "-") {
                if extra_flags == "" { set extra_flags = a } else { set extra_flags = extra_flags + " " + a }
            } else {
                set extra_flags = extra_flags + " " + a
            }
        }
        set i += 1
    }

    if !is_proj {
        if cli_file == "" {
            if file_idx > 0 && file_idx < n { set cli_file = rt_vec_get_str(args file_idx) }
        }
        if cli_file == "" {
            use! util::error_line("OWL0002" "no file specified and no owl.toml found")
            exit(1)
        } else {
            set argv = [] :vec[str] mut
            set argv = vec::push::str(argv "build")
            set argv = vec::push::str(argv cli_file)
            if cli_profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
            if cli_opt != "" {
                set argv = vec::push::str(argv "-O")
                set argv = vec::push::str(argv cli_opt)
            }
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            if extra_flags != "" {
                set toks = strings::split(extra_flags " ")
                set ti = 0 :i64 mut
                while ti < len(toks) {
                    set tk = use! util::list_get(toks ti)
                    if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                    set ti += 1
                }
            }
            set out = use! util::run_compiler(argv)
            use dasu(out)
        }
} else {
        if !use! ensure_project_dependencies() {
            use! util::error_line("OWL0003" "dependencies are unresolved")
            exit(1)
        } else {
            set entry = use! util::config_required("project" "entry")
            set file = entry :str mut
            if cli_file != "" && fs::exists(cli_file) { set file = cli_file }
            
            set profile = use! util::config_required("build" "profile") :str mut
            set opt = use! util::config_required("build" "opt-level") :str mut
            if cli_profile != "" { set profile = cli_profile }
            if cli_opt != "" { set opt = cli_opt }

            set out_dir = use! util::config_required("paths" "output") :str mut
            set cache_dir = use! util::config_required("paths" "cache") :str mut

            set out_dir2 = use! util::config_required("paths" "output")
            set compiler_output = output + "/" + profile
            set mire_config = cache + "/mire-config.toml"
            if !use! util::write_mire_config(strings::copy(mire_config) strings::copy(entry) strings::copy(profile) strings::copy(opt) strings::copy(artifact) strings::copy(runtime) strings::copy(target) strings::copy(compiler_output) strings::copy(cache) use! deps::compiler_lib_dirs()) {
                use! util::error_line("OWL0005" "could not write normalized Mire configuration")
                exit(1)
            }

            set argv = [] :vec[str] mut
            set argv = vec::push::str(argv "build")
            set argv = vec::push::str(argv strings::copy(file))
            set argv = vec::push::str(argv "--config")
            set argv = vec::push::str(argv strings::copy(mire_config))
            if profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
            set argv = vec::push::str(argv "-O")
            set argv = vec::push::str(argv strings::copy(opt))
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            if extra_flags != "" {
                set toks = strings::split(extra_flags " ")
                set ti = 0 :i64 mut
                while ti < len(toks) {
                    set tk = use! util::list_get(toks ti)
                    if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                    set ti += 1
                }
            }
            use dasu("  [" + profile + " -O" + opt + "]")
            
            if is_run {
                set build_out = use! util::run_compiler(argv)
                use dasu(build_out)
                if use proc::run_last_exit() == 0 { 
                    use! util::record_build() 
                    set name = entry :str mut
                    if cli_file != "" && (fs::exists(cli_file) || use! util::endswith(cli_file ".mire")) { set name = cli_file }
                    if use! util::endswith(name ".mire") {
                        set name = use! util::replace(name ".mire" "")
                    }
                    set parts = use! util::split(name "/")
                    set name = use! util::list_get(parts len(parts) - 1)
                    set bin = "./" + out_dir2 + "/" + profile + "/" + name :str mut
                    use dasu("")
                    use dasu("  running " + bin + " ...")
                    use proc::run_spawn(bin run_args)
                }
            } else {
                set out = use! util::run_compiler(argv)
                use dasu(out)
                if use proc::run_last_exit() == 0 { use! util::record_build() }
            }
        }
    }
}

