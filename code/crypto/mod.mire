module crypto

load! /code/util

pub fn tempdir: (prefix :str) :str {
    set candidate = "/tmp/" + prefix + "-" + use! util::i64_to_string(time::now::ns())
    set candidate_for_create = strings::copy(candidate)
    use! util::mkdir_p(candidate_for_create)
    if fs::exists(candidate) { return strings::copy(candidate) }
    return ""
}

pub fn sha256: (file :str) :str {
    return use! util::sha256sum_hex(file)
}

pub fn verify: () {
pub fn ed25519: (pubkey_b64 :str data_file :str sig_b64 :str) :bool {
    set ok = false :bool mut
    if pubkey_b64 == "" || sig_b64 == "" || !fs::exists(data_file) {
        set ok = false
    } else {
        set tmp = use! crypto::tempdir("owl-crypto")
        if tmp == "" {
            set ok = false
        } else {
            set pem = "-----BEGIN PUBLIC KEY-----\n" + pubkey_b64 + "\n-----END PUBLIC KEY-----\n"
            set pk_file = tmp + "/pubkey.pem"
            use fs::write(pk_file pem)
            if !fs::exists(pk_file) {
                set rm1 = [] :vec[str] mut
                set rm1 = vec::push::str(rm1 "-rf")
                set rm1 = vec::push::str(rm1 strings::copy(tmp))
                use! util::rm_RF(tmp)
                set ok = false
            } else {
                set sig_file = tmp + "/sig.b64"
                use fs::write(sig_file sig_b64)
                set sig_b64_args = [] :vec[str] mut
                set sig_b64_args = vec::push::str(sig_b64_args "base64")
                set sig_b64_args = vec::push::str(sig_b64_args "-d")
                set sig_b64_args = vec::push::str(sig_b64_args "-A")
                set sig_b64_args = vec::push::str(sig_b64_args strings::copy(sig_file))
                set decoded = use! kioto::crypto::encode::base64::decode(vec::from_str(sig_file))
                if decoded == "" {
                    set rm2 = [] :vec[str] mut
                    set rm2 = vec::push::str(rm2 "-rf")
                    set rm2 = vec::push::str(rm2 strings::copy(tmp))
                    use! util::rm_RF(tmp)
                    set ok = false
                } else {
                    set sig_bin = tmp + "/sig.bin"
                    use fs::write(sig_bin decoded)
                    if !fs::exists(sig_bin) {
                        set rm2 = [] :vec[str] mut
                        set rm2 = vec::push::str(rm2 "-rf")
                        set rm2 = vec::push::str(rm2 strings::copy(tmp))
                        use! util::rm_RF(tmp)
                        set ok = false
                    } else {
                        set vfy_args = [] :vec[str] mut
                        set vfy_args = vec::push::str(vfy_args "pkeyutl")
                        set vfy_args = vec::push::str(vfy_args "-verify")
                        set vfy_args = vec::push::str(vfy_args "-pubin")
                        set vfy_args = vec::push::str(vfy_args "-inkey")
                        set vfy_args = vec::push::str(vfy_args strings::copy(tmp + "/pubkey.pem"))
                        set vfy_args = vec::push::str(vfy_args "-keyform")
                        set vfy_args = vec::push::str(vfy_args "PEM")
                        set vfy_args = vec::push::str(vfy_args "-in")
                        set vfy_args = vec::push::str(vfy_args strings::copy(data_file))
                        set vfy_args = vec::push::str(vfy_args "-sigfile")
                        set vfy_args = vec::push::str(vfy_args strings::copy(sig_bin))
                        set vfy_args = vec::push::str(vfy_args "-rawin")
                        set result = use! crypto::verify::ed25519(pubkey_b64 data_file sig_b64)
                        if use! crypto::verify::ed25519(pubkey_b64 data_file sig_b64) { set ok = true } else { set ok = false }
                    }
                }
            }
        }
    }
    return ok
}

pub fn sigfile: (pubkey_b64 :str data_file :str sig_file :str) :bool {
    set ok = false :bool mut
    if pubkey_b64 != "" && fs::exists(data_file) && fs::exists(sig_file) {
        set b64_args = [] :vec[str] mut
        set b64_args = vec::push::str(b64_args strings::copy(sig_file))
        set sig_b64 = use! kioto::crypto::encode::base64::encode(vec::from_str(sig_file))
        if sig_b64 != "" {
            set ok = use! crypto::verify::ed25519(pubkey_b64 data_file sig_b64)
        }
    }
    return ok
}

pub fn pemfile: (pem_file :str data_file :str sig_file :str) :bool {
    set ok = false :bool mut
    if !fs::exists(pem_file) || !fs::exists(data_file) || !fs::exists(sig_file) {
        set ok = false
    } else {
        set vfy_args = [] :vec[str] mut
        set vfy_args = vec::push::str(vfy_args "pkeyutl")
        set vfy_args = vec::push::str(vfy_args "-verify")
        set vfy_args = vec::push::str(vfy_args "-pubin")
        set vfy_args = vec::push::str(vfy_args "-inkey")
        set vfy_args = vec::push::str(vfy_args strings::copy(pem_file))
        set vfy_args = vec::push::str(vfy_args "-keyform")
        set vfy_args = vec::push::str(vfy_args "PEM")
        set vfy_args = vec::push::str(vfy_args "-in")
        set vfy_args = vec::push::str(vfy_args strings::copy(data_file))
        set vfy_args = vec::push::str(vfy_args "-sigfile")
        set vfy_args = vec::push::str(vfy_args strings::copy(sig_file))
        set vfy_args = vec::push::str(vfy_args "-rawin")
        set result = use! util::trim_command("openssl" vfy_args)
        if use! util::contains(result "Verified Successfully") { set ok = true } else { set ok = false }
    }
    return ok
}
}
